{
  "redirects": [
    { "source": "/ticket", "destination": "/classic", "permanent": true },
    { "source": "/ticket/:path*", "destination": "/classic", "permanent": true }
  ],
  "rewrites": [
    { "source": "/embed", "destination": "/embed.html" },
    {
      "source": "/((?!api/|paragons$|paragons/|faq$|.*\\.[A-Za-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
