{
  "redirects": [
    {
      "source": "/classic",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/classic/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ticket",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ticket/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/embed",
      "destination": "/embed.html"
    },
    {
      "source": "/((?!api/|paragons$|paragons/|faq$|degrees$|about$|.*\\.[A-Za-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
